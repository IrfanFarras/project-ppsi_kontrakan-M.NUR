{
  "name": "rental-management-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API (Express + TypeScript + Prisma) for Rental Management System",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "npx --yes kill-port 4000",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "create-owner": "tsx src/scripts/create-owner.ts",
    "seed:dummy": "tsx src/scripts/seed-dummy.ts",
    "seed:dummy:clean": "tsx src/scripts/seed-dummy.ts --clean"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.15",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
